   "source": [
    "## Extraction of digits\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "6dbadbac-f503-4418-a17d-cf5065ce0bec",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter integer 123\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "3\n",
      "2\n",
      "1\n"
     ]
    }
   ],
   "source": [
    "# Extract the digits\n",
    "\n",
    "n=int(input('Enter integer'))\n",
    "num=n \n",
    "while num > 0: \n",
    "    last_digit=num%10\n",
    "    print(last_digit)\n",
    "    num=num//10"
   ]
